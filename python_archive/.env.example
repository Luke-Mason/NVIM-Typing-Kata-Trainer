# Claude API Configuration
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# Neovim Config Directory (optional - will auto-detect ~/.config/nvim)
# The trainer will parse all Lua files to extract your custom keybindings!
# Windows example:
#   NVIM_CONFIG_DIR=C:\Users\YourName\AppData\Local\nvim
# Unix/Mac example:
#   NVIM_CONFIG_DIR=/home/user/.config/nvim
# NVIM_CONFIG_DIR=

# Vimrc Path (optional - will auto-detect if not specified)
# For traditional Vim configurations
# Windows examples:
#   VIMRC_PATH=C:\Users\YourName\_vimrc
#   VIMRC_PATH=C:\Users\YourName\AppData\Local\nvim\init.vim
# Unix examples:
#   VIMRC_PATH=/home/user/.vimrc
#   VIMRC_PATH=/home/user/.config/nvim/init.vim
# VIMRC_PATH=

# Progress Directory (optional - defaults to ./progress)
PROGRESS_DIR=progress

# AI Feedback Timing (options: after_each_task, end_of_session, none)
# - after_each_task: Get immediate AI feedback after completing each vim motion task
# - end_of_session: Get batched feedback at the end of your training session
# - none: Disable AI feedback (still generates lessons, just no keystroke analysis)
AI_FEEDBACK_TIMING=end_of_session

# Universal Exit Sequence (default: jk)
# Press these keys in quick succession (within 0.5s) to exit any game mode
UNIVERSAL_EXIT_SEQUENCE=jk

# Theme (default: default)
THEME=default
